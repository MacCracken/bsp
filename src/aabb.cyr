# aabb.cyr -- axis-aligned bounding boxes
# No globals. Pure functions. All 16.16 fixed-point.
#
# An AABB is stored as 4 values: top, bottom, left, right (all fixed-point).
# Passed via pointer to a 32-byte block:
#   [0]  top    (max Y)
#   [8]  bottom (min Y)
#   [16] left   (min X)
#   [24] right  (max X)

enum BBox {
    AABB_TOP = 0;
    AABB_BOTTOM = 8;
    AABB_LEFT = 16;
    AABB_RIGHT = 24;
    AABB_SIZE = 32;
    # Inverted seeds for an "empty" box, +-2^61.
    #
    # These were +-2^31 through 1.2.2, which is the same defect class as the
    # bsp_nearest_seg sentinel fixed in 1.2.0: coordinates here are 16.16 in
    # 64-BIT integers, so any world coordinate above 32767.99 produces a fixed
    # value LARGER than a 2^31 seed and aabb_add_point's comparisons never
    # fire. A box built from the single point (40000, 40000) measured 7232
    # world units wide and reported (35000, 35000) as inside it.
    #
    # NOT INT64_MIN/INT64_MAX: aabb_width computes RIGHT - LEFT, and
    # INT64_MIN - INT64_MAX wraps to +1, so a fresh box would report width 1
    # while still passing fuzz_aabb's "width >= 0" invariant. At +-2^61 that
    # subtraction is -2^62 — representable and negative — so aabb_width and
    # aabb_height still return 0 on a fresh box, and aabb_center_x now returns
    # exactly 0 instead of the -1 the asymmetric 2^31 pair produced.
    # Stored as the MAGNITUDE only: a Cyrius enum initialiser must be a
    # non-negative literal (`AABB_EMPTY = -1125...` is "expected number,
    # got '-'"), so the negative seed is written `0 - AABB_EMPTY` below.
    #
    # 2^50, NOT something larger. The upper bound is set by frustum.cyr, not by
    # aabb.cyr: frustum_test_aabb computes `lx = asr(LEFT - vx, 4)` and then
    # `fx_mul(lx, lnx)` where `lnx = asr(normal, 4)` reaches 2^12 for a unit
    # normal. That product must stay under 2^63, so |sentinel| must be under
    # 2^55. A 2^61 seed overflows it — measured: the raw product came out as
    # exactly 0 (the low 64 bits of 2^69), which would silently flip a corner's
    # half-plane sign and cull or un-cull a fresh box arbitrarily.
    #
    # 2^50 fixed is ~1.7e10 world units — far past any plausible map, and 32x
    # under the frustum ceiling.
    AABB_EMPTY = 1125899906842624;
}

# Initialize an AABB to "empty" (inverted extremes), ready for aabb_add_point.
# A fresh box has width 0, height 0, centre (0,0), and contains no point.
#
# SUPPORTED COORDINATE RANGE: |coord| < AABB_EMPTY (2^50 fixed, ~1.7e10 world
# units). A coordinate at or beyond the sentinel does not beat it, so
# aabb_add_point silently leaves that edge at the sentinel and the box is
# wrong. The bound cannot simply be raised — frustum_test_aabb multiplies
# `asr(edge, 4)` by a normal of up to 2^12 and needs the sentinel under 2^55.
# 16.16 fixed-point has ~32768 world units of useful precision anyway
# (see fx_from_int), so this ceiling is far past any real map.
fn aabb_init(box) {
    store64(box + AABB_TOP, 0 - AABB_EMPTY);
    store64(box + AABB_BOTTOM, AABB_EMPTY);
    store64(box + AABB_LEFT, AABB_EMPTY);
    store64(box + AABB_RIGHT, 0 - AABB_EMPTY);
    return 0;
}

# Set AABB from explicit values
fn aabb_set(box, top, bottom, left, right) {
    store64(box + AABB_TOP, top);
    store64(box + AABB_BOTTOM, bottom);
    store64(box + AABB_LEFT, left);
    store64(box + AABB_RIGHT, right);
    return 0;
}

# Expand AABB to include point (px, py)
fn aabb_add_point(box, px, py) {
    if (py > load64(box + AABB_TOP)) { store64(box + AABB_TOP, py); }
    if (py < load64(box + AABB_BOTTOM)) { store64(box + AABB_BOTTOM, py); }
    if (px < load64(box + AABB_LEFT)) { store64(box + AABB_LEFT, px); }
    if (px > load64(box + AABB_RIGHT)) { store64(box + AABB_RIGHT, px); }
    return 0;
}

# Test if point (px, py) is inside AABB
fn aabb_contains_point(box, px, py) {
    if (px < load64(box + AABB_LEFT)) { return 0; }
    if (px > load64(box + AABB_RIGHT)) { return 0; }
    if (py < load64(box + AABB_BOTTOM)) { return 0; }
    if (py > load64(box + AABB_TOP)) { return 0; }
    return 1;
}

# Test if two AABBs overlap
fn aabb_intersects(a, b) {
    if (load64(a + AABB_LEFT) > load64(b + AABB_RIGHT)) { return 0; }
    if (load64(a + AABB_RIGHT) < load64(b + AABB_LEFT)) { return 0; }
    if (load64(a + AABB_BOTTOM) > load64(b + AABB_TOP)) { return 0; }
    if (load64(a + AABB_TOP) < load64(b + AABB_BOTTOM)) { return 0; }
    return 1;
}

# Merge AABB b into AABB a (a = union of a and b)
fn aabb_merge(a, b) {
    var bt = load64(b + AABB_TOP);
    var bb = load64(b + AABB_BOTTOM);
    var bl = load64(b + AABB_LEFT);
    var br = load64(b + AABB_RIGHT);
    if (bt > load64(a + AABB_TOP)) { store64(a + AABB_TOP, bt); }
    if (bb < load64(a + AABB_BOTTOM)) { store64(a + AABB_BOTTOM, bb); }
    if (bl < load64(a + AABB_LEFT)) { store64(a + AABB_LEFT, bl); }
    if (br > load64(a + AABB_RIGHT)) { store64(a + AABB_RIGHT, br); }
    return 0;
}

# Compute width of AABB
fn aabb_width(box) {
    var w = load64(box + AABB_RIGHT) - load64(box + AABB_LEFT);
    if (w < 0) { return 0; }
    return w;
}

# Compute height of AABB
fn aabb_height(box) {
    var h = load64(box + AABB_TOP) - load64(box + AABB_BOTTOM);
    if (h < 0) { return 0; }
    return h;
}

# Compute center X
fn aabb_center_x(box) {
    return asr(load64(box + AABB_LEFT) + load64(box + AABB_RIGHT), 1);
}

# Compute center Y
fn aabb_center_y(box) {
    return asr(load64(box + AABB_BOTTOM) + load64(box + AABB_TOP), 1);
}
