# fixed.cyr -- minimal 16.16 fixed-point math for BSP
# No dependencies. No globals. Pure functions only.
#
# IMPORTANT: Cyrius >> is LOGICAL right shift (zero-fill); >>> is the
# ARITHMETIC (sign-preserving) one. That is the REVERSE of JS/Java.
# Use asr() — or >>> directly — for all signed right shifts.

enum BspFixed {
    FX_ONE = 65536;
    FX_HALF = 32768;
    FX_MAX = 2147483647;
    FX_SHIFT = 16;
}

# Arithmetic (sign-preserving) right shift: FLOOR division of `val` by 2^bits.
# This is what C's `>>` does on signed ints, and what DOOM's fixed-point and
# coordinate math assume. Negatives round toward NEGATIVE INFINITY, so
# asr(-3, 1) is -2, not -1. `bits` must be in 0..63.
#
# Prefer this over a bare `>>` on any signed value — Cyrius `>>` is LOGICAL.
fn asr(val, bits) {
    # Implementation note, not API contract.
    #
    # This is now a thin alias for the NATIVE `>>>` operator (Cyrius v6.4.46).
    # BSP was pinned to 6.3.5 until 1.2.2, which predates `>>>`, so 1.1.0-1.2.2
    # synthesised the negative path by hand:
    #     if (val >= 0) { return val >> bits; }
    #     var pos = 0 - val;
    #     return 0 - ((pos + (1 << bits) - 1) >> bits);
    # `>>>` is bit-identical to that across the full signed range and every
    # shift width 0-31 (600,576-case differential, 1.2.3), and collapses a
    # branch + negate + add + shift + negate into a single `sar`.
    #
    # Kept as a function, not removed: it is public API that consumers call,
    # and one named spelling of the intent is worth more than 43 inlined
    # operators — especially since `>>>` sits on the TERM tier (with `* / %`),
    # BINDING TIGHTER than `+ - & | ^`, so `a + b >>> 16` means `a + (b >>> 16)`.
    # Any direct use over a sum MUST parenthesise. asr() has no such trap.
    #
    # Round-toward-ZERO was the pre-1.2.1 bug here (asr(-3,1) gave -1, not -2):
    # it mis-wrapped flats by one texel over negative world coordinates and
    # doubled the texel band straddling a world axis (audit RC-F2).
    return val >>> bits;
}

# Convert a plain integer to 16.16 fixed-point. fx_from_int(1) == FX_ONE.
# No range check: |n| above 32767 overflows the 16.16 representable range.
fn fx_from_int(n) { return n << 16; }

# Convert 16.16 fixed-point back to a plain integer, rounding toward
# NEGATIVE INFINITY (floor). fx_to_int(-32768) is -1, not 0.
fn fx_to_int(f) { return asr(f, 16); }

# Multiply two 16.16 fixed-point values. The intermediate product is 64-bit,
# so |a*b| up to 2^63 is safe; each result is floored independently, so
# fx_mul is NOT associative across a chain of products.
fn fx_mul(a, b) { return asr(a * b, 16); }

# Divide two 16.16 fixed-point values. The result is always within +-FX_MAX;
# out-of-range quotients saturate toward the sign of the true quotient.
# Divide-by-zero saturates the same way rather than trapping, so callers that
# must distinguish a saturated result from a real one have to check the
# divisor themselves.
#
# REWRITTEN IN 1.2.4. The 1.1.0-1.2.3 body was:
#
#     if (b == 0) { return FX_MAX; }
#     if (fx_abs(aa) > 32767) { aa = asr(aa,8); bb = asr(bb,8);
#                               if (bb == 0) { return FX_MAX; } }
#     return (aa << 16) / bb;
#
# which had three defects on VALID input, all measured:
#
#  1. The scale-down triggered at |a| > 32767 — about 2^32 times too eager.
#     `aa << 16` only overflows i64 at |a| >= 2^47, so almost every scaled
#     division was throwing away 8 bits of both operands for no reason.
#  2. `asr` is FLOOR, so scaling the DIVISOR sent a positive 1..255 to 0 and
#     returned the divide-by-zero sentinel for a perfectly representable
#     quotient — fx_div(100000, 255) gave FX_MAX instead of 25700392 — while a
#     negative -1..-255 floored to -1, so every divisor in that range produced
#     the SAME wrong answer (fx_div(100000, -1) and (100000, -255) both gave
#     -25559040, up to 256x off).
#  3. The sentinel was always +FX_MAX regardless of sign, so fx_div(-100000,
#     100) returned +2147483647 where the true quotient is -65536000 — a sign
#     INVERSION, reachable through bsp_point_seg_dist's projection term.
#
# Now: scale only when the shift would actually overflow, scale the divisor by
# MAGNITUDE so both signs behave identically, and saturate with the correct
# sign. Bounds are compared directly rather than via fx_abs, because
# fx_abs(INT64_MIN) is itself negative.
fn fx_div(a, b) {
    # Sign of the true quotient, tracked up front so every saturating exit
    # picks the right end of the range.
    var neg = 0;
    if (a < 0) { neg = 1 - neg; }
    if (b < 0) { neg = 1 - neg; }

    if (b == 0) {
        if (a < 0) { return 0 - FX_MAX; }
        return FX_MAX;
    }

    var aa = a;
    var bb = b;

    # 2^47: the point at which `aa << 16` stops fitting in i64.
    var big = 0;
    if (aa >= 140737488355328) { big = 1; }
    if (aa <= 0 - 140737488355328) { big = 1; }

    if (big == 1) {
        aa = asr(aa, 8);
        var bmag = bb;
        if (bmag < 0) { bmag = 0 - bmag; }
        bmag = bmag >> 8;
        if (bmag == 0) {
            # |a| >= 2^47 and |b| < 256, so the true quotient exceeds FX_MAX by
            # many orders of magnitude. Saturating is correct here.
            if (neg == 1) { return 0 - FX_MAX; }
            return FX_MAX;
        }
        bb = bmag;
        if (b < 0) { bb = 0 - bmag; }
    }

    var q = (aa << 16) / bb;
    if (q > FX_MAX) { return FX_MAX; }
    if (q < 0 - FX_MAX) { return 0 - FX_MAX; }
    return q;
}

# Absolute value. Scale-agnostic — works on fixed-point and plain integers.
fn fx_abs(f) { if (f < 0) { return -f; } return f; }

# Lesser of two values. Scale-agnostic.
fn fx_min(a, b) { if (a < b) { return a; } return b; }

# Greater of two values. Scale-agnostic.
fn fx_max(a, b) { if (a > b) { return a; } return b; }

# Clamp `f` into [lo, hi]. Scale-agnostic. Callers must pass lo <= hi;
# an inverted range returns `lo`.
fn fx_clamp(f, lo, hi) { if (f < lo) { return lo; } if (f > hi) { return hi; } return f; }
