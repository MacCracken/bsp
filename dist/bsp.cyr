# bsp.cyr -- bundled distribution
# Version: 1.2.4
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- fixed.cyr ---

# fixed.cyr -- minimal 16.16 fixed-point math for BSP
# No dependencies. No globals. Pure functions only.
#
# IMPORTANT: Cyrius >> is LOGICAL right shift (zero-fill); >>> is the
# ARITHMETIC (sign-preserving) one. That is the REVERSE of JS/Java.
# Use asr() — or >>> directly — for all signed right shifts.

enum BspFixed {
    FX_ONE = 65536;
    FX_HALF = 32768;
    FX_MAX = 2147483647;
    FX_SHIFT = 16;
}

# Arithmetic (sign-preserving) right shift: FLOOR division of `val` by 2^bits.
# This is what C's `>>` does on signed ints, and what DOOM's fixed-point and
# coordinate math assume. Negatives round toward NEGATIVE INFINITY, so
# asr(-3, 1) is -2, not -1. `bits` must be in 0..63.
#
# Prefer this over a bare `>>` on any signed value — Cyrius `>>` is LOGICAL.
fn asr(val, bits) {
    # Implementation note, not API contract.
    #
    # This is now a thin alias for the NATIVE `>>>` operator (Cyrius v6.4.46).
    # BSP was pinned to 6.3.5 until 1.2.2, which predates `>>>`, so 1.1.0-1.2.2
    # synthesised the negative path by hand:
    #     if (val >= 0) { return val >> bits; }
    #     var pos = 0 - val;
    #     return 0 - ((pos + (1 << bits) - 1) >> bits);
    # `>>>` is bit-identical to that across the full signed range and every
    # shift width 0-31 (600,576-case differential, 1.2.3), and collapses a
    # branch + negate + add + shift + negate into a single `sar`.
    #
    # Kept as a function, not removed: it is public API that consumers call,
    # and one named spelling of the intent is worth more than 43 inlined
    # operators — especially since `>>>` sits on the TERM tier (with `* / %`),
    # BINDING TIGHTER than `+ - & | ^`, so `a + b >>> 16` means `a + (b >>> 16)`.
    # Any direct use over a sum MUST parenthesise. asr() has no such trap.
    #
    # Round-toward-ZERO was the pre-1.2.1 bug here (asr(-3,1) gave -1, not -2):
    # it mis-wrapped flats by one texel over negative world coordinates and
    # doubled the texel band straddling a world axis (audit RC-F2).
    return val >>> bits;
}

# Convert a plain integer to 16.16 fixed-point. fx_from_int(1) == FX_ONE.
# No range check: |n| above 32767 overflows the 16.16 representable range.
fn fx_from_int(n) { return n << 16; }

# Convert 16.16 fixed-point back to a plain integer, rounding toward
# NEGATIVE INFINITY (floor). fx_to_int(-32768) is -1, not 0.
fn fx_to_int(f) { return asr(f, 16); }

# Multiply two 16.16 fixed-point values. The intermediate product is 64-bit,
# so |a*b| up to 2^63 is safe; each result is floored independently, so
# fx_mul is NOT associative across a chain of products.
fn fx_mul(a, b) { return asr(a * b, 16); }

# Divide two 16.16 fixed-point values. The result is always within +-FX_MAX;
# out-of-range quotients saturate toward the sign of the true quotient.
# Divide-by-zero saturates the same way rather than trapping, so callers that
# must distinguish a saturated result from a real one have to check the
# divisor themselves.
#
# REWRITTEN IN 1.2.4. The 1.1.0-1.2.3 body was:
#
#     if (b == 0) { return FX_MAX; }
#     if (fx_abs(aa) > 32767) { aa = asr(aa,8); bb = asr(bb,8);
#                               if (bb == 0) { return FX_MAX; } }
#     return (aa << 16) / bb;
#
# which had three defects on VALID input, all measured:
#
#  1. The scale-down triggered at |a| > 32767 — about 2^32 times too eager.
#     `aa << 16` only overflows i64 at |a| >= 2^47, so almost every scaled
#     division was throwing away 8 bits of both operands for no reason.
#  2. `asr` is FLOOR, so scaling the DIVISOR sent a positive 1..255 to 0 and
#     returned the divide-by-zero sentinel for a perfectly representable
#     quotient — fx_div(100000, 255) gave FX_MAX instead of 25700392 — while a
#     negative -1..-255 floored to -1, so every divisor in that range produced
#     the SAME wrong answer (fx_div(100000, -1) and (100000, -255) both gave
#     -25559040, up to 256x off).
#  3. The sentinel was always +FX_MAX regardless of sign, so fx_div(-100000,
#     100) returned +2147483647 where the true quotient is -65536000 — a sign
#     INVERSION, reachable through bsp_point_seg_dist's projection term.
#
# Now: scale only when the shift would actually overflow, scale the divisor by
# MAGNITUDE so both signs behave identically, and saturate with the correct
# sign. Bounds are compared directly rather than via fx_abs, because
# fx_abs(INT64_MIN) is itself negative.
fn fx_div(a, b) {
    # Sign of the true quotient, tracked up front so every saturating exit
    # picks the right end of the range.
    var neg = 0;
    if (a < 0) { neg = 1 - neg; }
    if (b < 0) { neg = 1 - neg; }

    if (b == 0) {
        if (a < 0) { return 0 - FX_MAX; }
        return FX_MAX;
    }

    var aa = a;
    var bb = b;

    # 2^47: the point at which `aa << 16` stops fitting in i64.
    var big = 0;
    if (aa >= 140737488355328) { big = 1; }
    if (aa <= 0 - 140737488355328) { big = 1; }

    if (big == 1) {
        aa = asr(aa, 8);
        var bmag = bb;
        if (bmag < 0) { bmag = 0 - bmag; }
        bmag = bmag >> 8;
        if (bmag == 0) {
            # |a| >= 2^47 and |b| < 256, so the true quotient exceeds FX_MAX by
            # many orders of magnitude. Saturating is correct here.
            if (neg == 1) { return 0 - FX_MAX; }
            return FX_MAX;
        }
        bb = bmag;
        if (b < 0) { bb = 0 - bmag; }
    }

    var q = (aa << 16) / bb;
    if (q > FX_MAX) { return FX_MAX; }
    if (q < 0 - FX_MAX) { return 0 - FX_MAX; }
    return q;
}

# Absolute value. Scale-agnostic — works on fixed-point and plain integers.
fn fx_abs(f) { if (f < 0) { return -f; } return f; }

# Lesser of two values. Scale-agnostic.
fn fx_min(a, b) { if (a < b) { return a; } return b; }

# Greater of two values. Scale-agnostic.
fn fx_max(a, b) { if (a > b) { return a; } return b; }

# Clamp `f` into [lo, hi]. Scale-agnostic. Callers must pass lo <= hi;
# an inverted range returns `lo`.
fn fx_clamp(f, lo, hi) { if (f < lo) { return lo; } if (f > hi) { return hi; } return f; }

# --- aabb.cyr ---

# aabb.cyr -- axis-aligned bounding boxes
# No globals. Pure functions. All 16.16 fixed-point.
#
# An AABB is stored as 4 values: top, bottom, left, right (all fixed-point).
# Passed via pointer to a 32-byte block:
#   [0]  top    (max Y)
#   [8]  bottom (min Y)
#   [16] left   (min X)
#   [24] right  (max X)

enum BBox {
    AABB_TOP = 0;
    AABB_BOTTOM = 8;
    AABB_LEFT = 16;
    AABB_RIGHT = 24;
    AABB_SIZE = 32;
    # Inverted seeds for an "empty" box, +-2^61.
    #
    # These were +-2^31 through 1.2.2, which is the same defect class as the
    # bsp_nearest_seg sentinel fixed in 1.2.0: coordinates here are 16.16 in
    # 64-BIT integers, so any world coordinate above 32767.99 produces a fixed
    # value LARGER than a 2^31 seed and aabb_add_point's comparisons never
    # fire. A box built from the single point (40000, 40000) measured 7232
    # world units wide and reported (35000, 35000) as inside it.
    #
    # NOT INT64_MIN/INT64_MAX: aabb_width computes RIGHT - LEFT, and
    # INT64_MIN - INT64_MAX wraps to +1, so a fresh box would report width 1
    # while still passing fuzz_aabb's "width >= 0" invariant. At +-2^61 that
    # subtraction is -2^62 — representable and negative — so aabb_width and
    # aabb_height still return 0 on a fresh box, and aabb_center_x now returns
    # exactly 0 instead of the -1 the asymmetric 2^31 pair produced.
    # Stored as the MAGNITUDE only: a Cyrius enum initialiser must be a
    # non-negative literal (`AABB_EMPTY = -1125...` is "expected number,
    # got '-'"), so the negative seed is written `0 - AABB_EMPTY` below.
    #
    # 2^50, NOT something larger. The upper bound is set by frustum.cyr, not by
    # aabb.cyr: frustum_test_aabb computes `lx = asr(LEFT - vx, 4)` and then
    # `fx_mul(lx, lnx)` where `lnx = asr(normal, 4)` reaches 2^12 for a unit
    # normal. That product must stay under 2^63, so |sentinel| must be under
    # 2^55. A 2^61 seed overflows it — measured: the raw product came out as
    # exactly 0 (the low 64 bits of 2^69), which would silently flip a corner's
    # half-plane sign and cull or un-cull a fresh box arbitrarily.
    #
    # 2^50 fixed is ~1.7e10 world units — far past any plausible map, and 32x
    # under the frustum ceiling.
    AABB_EMPTY = 1125899906842624;
}

# Initialize an AABB to "empty" (inverted extremes), ready for aabb_add_point.
# A fresh box has width 0, height 0, centre (0,0), and contains no point.
#
# SUPPORTED COORDINATE RANGE: |coord| < AABB_EMPTY (2^50 fixed, ~1.7e10 world
# units). A coordinate at or beyond the sentinel does not beat it, so
# aabb_add_point silently leaves that edge at the sentinel and the box is
# wrong. The bound cannot simply be raised — frustum_test_aabb multiplies
# `asr(edge, 4)` by a normal of up to 2^12 and needs the sentinel under 2^55.
# 16.16 fixed-point has ~32768 world units of useful precision anyway
# (see fx_from_int), so this ceiling is far past any real map.
fn aabb_init(box) {
    store64(box + AABB_TOP, 0 - AABB_EMPTY);
    store64(box + AABB_BOTTOM, AABB_EMPTY);
    store64(box + AABB_LEFT, AABB_EMPTY);
    store64(box + AABB_RIGHT, 0 - AABB_EMPTY);
    return 0;
}

# Set AABB from explicit values
fn aabb_set(box, top, bottom, left, right) {
    store64(box + AABB_TOP, top);
    store64(box + AABB_BOTTOM, bottom);
    store64(box + AABB_LEFT, left);
    store64(box + AABB_RIGHT, right);
    return 0;
}

# Expand AABB to include point (px, py)
fn aabb_add_point(box, px, py) {
    if (py > load64(box + AABB_TOP)) { store64(box + AABB_TOP, py); }
    if (py < load64(box + AABB_BOTTOM)) { store64(box + AABB_BOTTOM, py); }
    if (px < load64(box + AABB_LEFT)) { store64(box + AABB_LEFT, px); }
    if (px > load64(box + AABB_RIGHT)) { store64(box + AABB_RIGHT, px); }
    return 0;
}

# Test if point (px, py) is inside AABB
fn aabb_contains_point(box, px, py) {
    if (px < load64(box + AABB_LEFT)) { return 0; }
    if (px > load64(box + AABB_RIGHT)) { return 0; }
    if (py < load64(box + AABB_BOTTOM)) { return 0; }
    if (py > load64(box + AABB_TOP)) { return 0; }
    return 1;
}

# Test if two AABBs overlap
fn aabb_intersects(a, b) {
    if (load64(a + AABB_LEFT) > load64(b + AABB_RIGHT)) { return 0; }
    if (load64(a + AABB_RIGHT) < load64(b + AABB_LEFT)) { return 0; }
    if (load64(a + AABB_BOTTOM) > load64(b + AABB_TOP)) { return 0; }
    if (load64(a + AABB_TOP) < load64(b + AABB_BOTTOM)) { return 0; }
    return 1;
}

# Merge AABB b into AABB a (a = union of a and b)
fn aabb_merge(a, b) {
    var bt = load64(b + AABB_TOP);
    var bb = load64(b + AABB_BOTTOM);
    var bl = load64(b + AABB_LEFT);
    var br = load64(b + AABB_RIGHT);
    if (bt > load64(a + AABB_TOP)) { store64(a + AABB_TOP, bt); }
    if (bb < load64(a + AABB_BOTTOM)) { store64(a + AABB_BOTTOM, bb); }
    if (bl < load64(a + AABB_LEFT)) { store64(a + AABB_LEFT, bl); }
    if (br > load64(a + AABB_RIGHT)) { store64(a + AABB_RIGHT, br); }
    return 0;
}

# Compute width of AABB
fn aabb_width(box) {
    var w = load64(box + AABB_RIGHT) - load64(box + AABB_LEFT);
    if (w < 0) { return 0; }
    return w;
}

# Compute height of AABB
fn aabb_height(box) {
    var h = load64(box + AABB_TOP) - load64(box + AABB_BOTTOM);
    if (h < 0) { return 0; }
    return h;
}

# Compute center X
fn aabb_center_x(box) {
    return asr(load64(box + AABB_LEFT) + load64(box + AABB_RIGHT), 1);
}

# Compute center Y
fn aabb_center_y(box) {
    return asr(load64(box + AABB_BOTTOM) + load64(box + AABB_TOP), 1);
}

# --- intersect.cyr ---

# intersect.cyr -- line/segment/ray intersection tests
# No globals. Pure functions. All 16.16 fixed-point.
#
# Coordinates are passed as individual x,y values (not structs)
# to keep the API simple and avoid heap allocation.

# ================================================================
# Point-on-side of a line
# ================================================================
# Given a line from (lx, ly) in direction (ldx, ldy),
# determine which side point (px, py) is on.
# Returns: 0 = right/front, 1 = left/back
#
# Uses cross product: (px-lx)*ldy - (py-ly)*ldx
# Positive = right, negative = left
fn bsp_point_side(px, py, lx, ly, ldx, ldy) {
    var dx = px - lx;
    var dy = py - ly;
    # Pre-shift each operand by 8 (asr) before multiplying so the cross
    # product can't overflow i64 at DOOM coordinate scale. DOOM coords run
    # to ~±2^31 fixed; the operand differences here (dx, ldy) reach ~±2^32,
    # so a full-precision product would be ~2^64 and overflow. Pre-shifting
    # yields operands of ~±2^24, products ~±2^48 — well within range. Cost:
    # ~8 bits of precision per operand, so a point within ~1/256 of the
    # line's scale may classify to the wrong side. A smaller shift (asr 4,
    # as frustum.cyr uses) is also overflow-safe here and keeps more
    # precision, but it MOVES the side-classification boundary — changing
    # stable test/fuzz outputs across the 1.x API — so do not change it
    # without re-running tests + fuzz.
    var left = (asr(dx, 8) * asr(ldy, 8)) ;
    var right = (asr(dy, 8) * asr(ldx, 8)) ;
    if (left >= right) { return 0; }
    return 1;
}

# ================================================================
# Segment-segment intersection
# ================================================================

# Internal: range-check both parametric numerators against a shared
# denominator without dividing, so a degenerate input cannot raise SIGFPE.
# Tests 0 <= t1_num/denom <= 1 and the same for t2_num, with the comparison
# sense flipped when denom is negative.
#
# PRECONDITION: denom != 0. A zero denominator falls through both branches and
# returns 1 (parallel segments reported as intersecting) — every caller must
# reject denom == 0 first, as bsp_seg_intersect does.
fn _seg_check(denom, t1_num, t2_num) {
    if (denom > 0) {
        if (t1_num < 0) { return 0; }
        if (t1_num > denom) { return 0; }
        if (t2_num < 0) { return 0; }
        if (t2_num > denom) { return 0; }
    }
    if (denom < 0) {
        if (t1_num > 0) { return 0; }
        if (t1_num < denom) { return 0; }
        if (t2_num > 0) { return 0; }
        if (t2_num < denom) { return 0; }
    }
    return 1;
}

# Test whether segment (ax1,ay1)-(ax2,ay2) crosses (bx1,by1)-(bx2,by2).
# Returns 1 if they intersect, 0 if not.
#
# Uses the parametric form -- find t1, t2 where
#   A1 + t1*(A2-A1) = B1 + t2*(B2-B1)
# with an intersection when 0 <= t1 <= 1 and 0 <= t2 <= 1. Division-free: the
# t-ranges are checked against the denominator by sign, never divided, so
# parallel and zero-length inputs return 0 rather than trapping.
#
# Endpoint-touching counts as an intersection (the range checks are
# inclusive). Collinear overlapping segments have a zero denominator and are
# therefore reported as NOT intersecting.
#
# All operands are pre-shifted by 8 bits, so segments whose extent is below
# ~1/256 of a world unit collapse and report no intersection.
fn bsp_seg_intersect(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2) {
    # Pre-shift each delta by 8 once (asr is signed, deterministic) — the
    # un-shifted deltas are used nowhere else, so this is value-identical to
    # shifting at each use and halves the asr count (12 → 6).
    var dax = asr(ax2 - ax1, 8);
    var day = asr(ay2 - ay1, 8);
    var dbx = asr(bx2 - bx1, 8);
    var dby = asr(by2 - by1, 8);
    var denom = dax * dby - day * dbx;
    if (denom == 0) { return 0; }
    var abx = asr(bx1 - ax1, 8);
    var aby = asr(by1 - ay1, 8);
    var t1_num = abx * dby - aby * dbx;
    var t2_num = abx * day - aby * dax;
    return _seg_check(denom, t1_num, t2_num);
}

# Internal: bsp_seg_intersect with the A-segment deltas ALREADY pre-shifted, so
# a caller testing many B-segments against ONE fixed A-segment can hoist them
# out of its loop. bsp_check_sight is exactly that shape.
#
# Value-identical to bsp_seg_intersect: same operands, same operation order.
# The two bodies are duplicated deliberately -- routing bsp_seg_intersect
# through this helper costs the primitive a call it cannot afford
# (seg_intersect_hit 52 -> 59 ns, miss 39 -> 46 ns, measured). Any change to
# one MUST be mirrored in the other; the whole-API differential probe exercises
# both against a reference build and will catch divergence.
fn _seg_intersect_pre(ax1, ay1, dax, day, bx1, by1, bx2, by2) {
    var dbx = asr(bx2 - bx1, 8);
    var dby = asr(by2 - by1, 8);
    var denom = dax * dby - day * dbx;
    if (denom == 0) { return 0; }
    var abx = asr(bx1 - ax1, 8);
    var aby = asr(by1 - ay1, 8);
    var t1_num = abx * dby - aby * dbx;
    var t2_num = abx * day - aby * dax;
    return _seg_check(denom, t1_num, t2_num);
}

# ================================================================
# Line-of-sight test
# ================================================================
# Can point (sx,sy) see point (tx,ty) without being blocked
# by any one-sided wall segment?
#
# walls = pointer to array of segments, each 32 bytes:
#   [0] x1, [8] y1, [16] x2, [24] y2 (all fixed-point)
# wall_count = number of segments
# twosided_flags = pointer to array of i64 (1=two-sided, 0=one-sided)
#
# Returns 1 if visible, 0 if blocked.
fn bsp_check_sight(sx, sy, tx, ty, walls, wall_count, twosided_flags) {
    # The sight ray is fixed across the loop, so its pre-shifted deltas are
    # loop-invariant; bsp_seg_intersect recomputed them once PER WALL.
    var dax = asr(tx - sx, 8);
    var day = asr(ty - sy, 8);

    for (var i = 0; i < wall_count; i += 1) {
        # Skip two-sided walls (they don't block sight)
        if (load64(twosided_flags + i * 8) != 0) { continue; }

        var base = walls + i * 32;
        var wx1 = load64(base);
        var wy1 = load64(base + 8);
        var wx2 = load64(base + 16);
        var wy2 = load64(base + 24);

        if (_seg_intersect_pre(sx, sy, dax, day, wx1, wy1, wx2, wy2) == 1) {
            return 0;
        }
    }
    return 1;
}

# ================================================================
# Ray cast
# ================================================================
# Cast a ray from (ox, oy) in direction (dx, dy) against a segment
# (sx1,sy1)-(sx2,sy2). Returns the parametric t along the ray
# where intersection occurs (0..FX_MAX), or -1 if no hit.
# The actual intersection point = (ox + t*dx, oy + t*dy).
fn bsp_ray_cast(ox, oy, dx, dy, sx1, sy1, sx2, sy2) {
    # Pre-shift each operand by 8 once (asr is signed, deterministic) — the
    # un-shifted dx/dy/sdx/sdy/abx/aby feed only these products, so this is
    # value-identical to shifting at each use and halves the asr count (12 → 6).
    var sdx = asr(sx2 - sx1, 8);
    var sdy = asr(sy2 - sy1, 8);
    var dxs = asr(dx, 8);
    var dys = asr(dy, 8);

    var denom = dxs * sdy - dys * sdx;
    if (denom == 0) { return -1; }

    var abx = asr(sx1 - ox, 8);
    var aby = asr(sy1 - oy, 8);

    var t_ray_num = abx * sdy - aby * sdx;
    var t_seg_num = abx * dys - aby * dxs;

    # Check signs without division
    if (denom > 0) {
        if (t_ray_num < 0) { return -1; }
        if (t_seg_num < 0) { return -1; }
        if (t_seg_num > denom) { return -1; }
    } else {
        if (t_ray_num > 0) { return -1; }
        if (t_seg_num > 0) { return -1; }
        if (t_seg_num < denom) { return -1; }
    }

    # Safe to divide now (denom != 0, signs checked)
    return fx_div(t_ray_num, denom);
}

# ================================================================
# Point-to-segment distance (approximate)
# ================================================================
# Returns the approximate distance from point (px,py) to the
# nearest point on segment (sx1,sy1)-(sx2,sy2).
# Uses projection + DOOM-style approximate distance.
fn bsp_point_seg_dist(px, py, sx1, sy1, sx2, sy2) {
    var sdx = sx2 - sx1;
    var sdy = sy2 - sy1;
    var pdx = px - sx1;
    var pdy = py - sy1;

    var sdx_s = asr(sdx, 8);
    var sdy_s = asr(sdy, 8);
    var len_sq = fx_mul(sdx_s, sdx_s) + fx_mul(sdy_s, sdy_s);
    if (len_sq <= 0) {
        # Degenerate (zero-length) OR sub-precision segment (>>8 collapsed
        # len_sq to 0). Pick the nearer of the two endpoints; distance to
        # only sx1/sy1 would break symmetry for points past sx2/sy2.
        var d1 = _approx_dist(pdx, pdy);
        var d2 = _approx_dist(px - sx2, py - sy2);
        if (d1 < d2) { return d1; }
        return d2;
    }

    # Project point onto line: t = dot(p-s1, s2-s1) / |s2-s1|^2
    # pdx/pdy are signed; must use asr() to preserve sign through the shift.
    var dot = fx_mul(asr(pdx, 8), sdx_s) + fx_mul(asr(pdy, 8), sdy_s);
    var t = fx_div(dot, len_sq);
    t = fx_clamp(t, 0, FX_ONE);

    # Closest point on segment
    var cx = sx1 + fx_mul(t, sdx);
    var cy = sy1 + fx_mul(t, sdy);

    # Approximate distance (DOOM's P_AproxDistance)
    return _approx_dist(px - cx, py - cy);
}

# DOOM P_AproxDistance: max(|dx|,|dy|) + min(|dx|,|dy|)/2.
# Factored out so the degenerate path stays symmetric with the main path.
fn _approx_dist(dx, dy) {
    var adx = fx_abs(dx);
    var ady = fx_abs(dy);
    if (adx > ady) { return adx + asr(ady, 1); }
    return ady + asr(adx, 1);
}

# --- tree.cyr ---

# tree.cyr -- BSP tree construction
# No globals. Pure functions. All 16.16 fixed-point.
#
# A BSP tree partitions 2D space using splitting lines.
# Each node stores a partition line and two children.
# Leaves (subsectors) contain the actual geometry.
#
# Tree is stored in caller-provided arrays:
#
# Nodes array: each node = 112 bytes
#   [0]   x      -- partition line origin X (fixed)
#   [8]   y      -- partition line origin Y (fixed)
#   [16]  dx     -- partition line direction X (fixed)
#   [24]  dy     -- partition line direction Y (fixed)
#   [32]  bbox_r -- right child bounding box (32 bytes)
#   [64]  bbox_l -- left child bounding box (32 bytes)
#   [96]  child_r -- right child index (bit 15 = subsector flag)
#   [104] child_l -- left child index (bit 15 = subsector flag)

enum BspNode {
    BSP_NODE_SIZE = 112;
    BSP_NODE_X = 0;
    BSP_NODE_Y = 8;
    BSP_NODE_DX = 16;
    BSP_NODE_DY = 24;
    BSP_NODE_BBOX_R = 32;
    BSP_NODE_BBOX_L = 64;
    BSP_NODE_CHILD_R = 96;
    BSP_NODE_CHILD_L = 104;
    BSP_NF_SUBSECTOR = 0x8000;
}

# Check if a child index refers to a subsector (leaf)
fn bsp_is_subsector(child) {
    if ((child & BSP_NF_SUBSECTOR) != 0) { return 1; }
    return 0;
}

# Extract subsector index from a child reference
fn bsp_subsector_idx(child) {
    return child & 0x7FFF;
}

# Partition line origin X of node `idx` (fixed-point).
# No bounds check: `idx` must be in 0..node_count-1.
fn bsp_node_x(nodes, idx) { return load64(nodes + idx * BSP_NODE_SIZE + BSP_NODE_X); }

# Partition line origin Y of node `idx` (fixed-point). No bounds check.
fn bsp_node_y(nodes, idx) { return load64(nodes + idx * BSP_NODE_SIZE + BSP_NODE_Y); }

# Partition line direction X of node `idx` (fixed-point). No bounds check.
fn bsp_node_dx(nodes, idx) { return load64(nodes + idx * BSP_NODE_SIZE + BSP_NODE_DX); }

# Partition line direction Y of node `idx` (fixed-point). No bounds check.
fn bsp_node_dy(nodes, idx) { return load64(nodes + idx * BSP_NODE_SIZE + BSP_NODE_DY); }

# Right (front) child reference of node `idx`. Test it with bsp_is_subsector:
# if set, it is a leaf and bsp_subsector_idx extracts the subsector number;
# otherwise it is another node index. No bounds check.
fn bsp_node_child_r(nodes, idx) { return load64(nodes + idx * BSP_NODE_SIZE + BSP_NODE_CHILD_R); }

# Left (back) child reference of node `idx`. Same encoding as the right child.
# No bounds check.
fn bsp_node_child_l(nodes, idx) { return load64(nodes + idx * BSP_NODE_SIZE + BSP_NODE_CHILD_L); }

# Pointer to the right child's 32-byte bounding box inside node `idx`.
# Usable directly with the aabb_* functions. No bounds check.
fn bsp_node_bbox_r(nodes, idx) { return nodes + idx * BSP_NODE_SIZE + BSP_NODE_BBOX_R; }

# Pointer to the left child's 32-byte bounding box inside node `idx`.
# Usable directly with the aabb_* functions. No bounds check.
fn bsp_node_bbox_l(nodes, idx) { return nodes + idx * BSP_NODE_SIZE + BSP_NODE_BBOX_L; }

# Set a node's partition line
fn bsp_node_set(nodes, idx, x, y, dx, dy) {
    var base = nodes + idx * BSP_NODE_SIZE;
    store64(base + BSP_NODE_X, x);
    store64(base + BSP_NODE_Y, y);
    store64(base + BSP_NODE_DX, dx);
    store64(base + BSP_NODE_DY, dy);
    return 0;
}

# Set a node's children
fn bsp_node_set_children(nodes, idx, right, left) {
    var base = nodes + idx * BSP_NODE_SIZE;
    store64(base + BSP_NODE_CHILD_R, right);
    store64(base + BSP_NODE_CHILD_L, left);
    return 0;
}

# --- traverse.cyr ---

# traverse.cyr -- BSP tree traversal
# No globals. Pure functions. All 16.16 fixed-point.
#
# Two traversal orders:
#   Front-to-back: for occlusion culling (renderer)
#   Back-to-front: for painter's algorithm
#
# The traversal itself doesn't draw anything -- it calls
# a visitor function pointer for each subsector reached.
# The visitor decides what to do (render, query, etc).
#
# Since Cyrius doesn't have easy function pointer dispatch yet,
# we provide the core decision functions and let the caller
# write their own traversal loop.

# ================================================================
# Point-on-side of BSP partition line
# ================================================================
# Determine which side of node's partition line the point is on.
# nodes = pointer to nodes array
# node_idx = which node
# px, py = point position (fixed-point)
# Returns: 0 = right/front, 1 = left/back
fn bsp_point_on_side(nodes, node_idx, px, py) {
    # Compute the node base once instead of four accessor calls that each
    # recompute node_idx * BSP_NODE_SIZE. Field offsets match the accessors
    # (BSP_NODE_X..BSP_NODE_DY); this is the hot path under bsp_find_subsector.
    var base = nodes + node_idx * BSP_NODE_SIZE;
    var nx = load64(base + BSP_NODE_X);
    var ny = load64(base + BSP_NODE_Y);
    var ndx = load64(base + BSP_NODE_DX);
    var ndy = load64(base + BSP_NODE_DY);
    return bsp_point_side(px, py, nx, ny, ndx, ndy);
}

# ================================================================
# Point-to-subsector lookup
# ================================================================
# Walk the BSP tree to find which subsector (leaf) contains
# the given point. Returns the subsector index.
# nodes = pointer to nodes array
# node_count = number of nodes (root = node_count - 1)
# px, py = point position (fixed-point)
fn bsp_find_subsector(nodes, node_count, px, py) {
    if (node_count == 0) { return 0; }

    # The child encoding puts the subsector flag in bit 15 and the index in the
    # low 15 bits, so a NODE index must fit in 0..0x7FFF. A larger node_count
    # cannot be addressed at all: the root index itself would have bit 15 set
    # and be read as a leaf. Reject it rather than silently resolving to a
    # garbage subsector (1.2.4; node_count 40000 previously returned 0x1C3F).
    if (node_count > 32768) { return 0; }

    var idx = node_count - 1;
    if (idx < 0) { return 0; }

    # Bound the walk by node_count. A well-formed tree visits each node at most
    # once and terminates at a subsector leaf, so none of these guards fire on
    # valid input — but `node_count` was previously used only to pick the root,
    # and nothing checked the child indices we follow. Three malformed-input
    # failures were reachable, and consumers build these arrays from map files
    # they did not author, so none of them are hypothetical:
    #
    #   1. A CYCLE hung here forever (a 2-node cycle spins indefinitely).
    #   2. A child index past the end of the array read arbitrary memory.
    #   3. A NEGATIVE child was silently accepted as a LEAF: two's complement
    #      sets bit 15, so bsp_is_subsector(-5) is 1 and bsp_subsector_idx
    #      returned -5 & 0x7FFF = 32763. No hang, no crash here — the caller
    #      then indexed its subsector array with 32763 and read out of bounds.
    #      That one has to be rejected where the child is READ, because the
    #      loop condition would already have classified it as a leaf.
    var steps = node_count;
    while (bsp_is_subsector(idx) == 0) {
        if (idx >= node_count) { return 0; }
        if (steps <= 0) { return 0; }
        steps -= 1;

        var side = bsp_point_on_side(nodes, idx, px, py);
        if (side == 0) {
            idx = bsp_node_child_r(nodes, idx);
        } else {
            idx = bsp_node_child_l(nodes, idx);
        }
        if (idx < 0) { return 0; }
        # High-side twin of the negative-child hole closed in 1.2.3. A child
        # reference only ever occupies 16 bits; anything above that still has
        # bit 15 set for one in every two values, so bsp_is_subsector accepts it
        # and bsp_subsector_idx masks it to 15 bits — 0x18000 silently became
        # subsector 0. Reject instead.
        if (idx > 65535) { return 0; }
    }

    return bsp_subsector_idx(idx);
}

# ================================================================
# AABB-in-view test (for traversal culling)
# ================================================================
# Test if a bounding box is potentially visible from a viewpoint.
# Simple test: is the bbox on the same side as the viewpoint,
# or does it straddle the partition line?
# Returns 1 if potentially visible, 0 if fully behind.
fn bsp_bbox_visible(bbox, vx, vy, vangle_cos, vangle_sin, fov_half) {
    # For now: always visible (conservative). Full frustum culling lives in
    # frustum.cyr (frustum_test_aabb); this remains a placeholder. The
    # bbox/vx/vy/vangle_cos/vangle_sin/fov_half params are kept for API
    # stability and the future cull implementation. No bbox fields are read
    # yet — loading them here would be dead work, so we don't.
    return 1;
}

# --- query.cyr ---

# query.cyr -- spatial queries on BSP trees
# No globals. Pure functions. All 16.16 fixed-point.

# ================================================================
# Point containment
# ================================================================
# Test if point (px, py) is inside the convex region defined
# by a set of line segments (subsector boundary).
#
# segs = pointer to segment array, each 32 bytes:
#   [0] x1, [8] y1, [16] x2, [24] y2
# seg_count = number of segments
#
# A point is inside if it's on the same side of all segments
# (assuming segments form a convex polygon wound consistently).
fn bsp_point_in_subsector(px, py, segs, seg_count) {
    # `<= 0`, not `== 0`. A NEGATIVE count skipped the loop and fell through to
    # `return 1` — reporting the point as INSIDE an empty set, the dangerous
    # direction for a containment test callers branch on for collision.
    if (seg_count <= 0) { return 0; }

    var first_side = -1;

    for (var i = 0; i < seg_count; i += 1) {
        var base = segs + i * 32;
        var x1 = load64(base);
        var y1 = load64(base + 8);
        var x2 = load64(base + 16);
        var y2 = load64(base + 24);

        var side = bsp_point_side(px, py, x1, y1, x2 - x1, y2 - y1);

        if (first_side < 0) {
            first_side = side;
        } else {
            if (side != first_side) { return 0; }
        }
    }

    return 1;
}

# ================================================================
# Nearest segment to point
# ================================================================
# Find the index of the nearest segment to point (px, py).
# segs = pointer to segment array (32 bytes each)
# seg_count = number of segments
# Returns segment index, or -1 if no segments.
fn bsp_nearest_seg(px, py, segs, seg_count) {
    # `<= 0`, not `== 0`. A NEGATIVE count skipped the loop and returned the
    # best_idx seed of 0 — a valid-looking index into an array with no entries.
    if (seg_count <= 0) { return -1; }

    var best_idx = 0;
    # Seed with INT64_MAX, not 2147483647 (=2^31-1, ~32768.0 world units):
    # bsp_point_seg_dist returns _approx_dist values up to ~1.5*2^32 for
    # 16.16 coords, so a 2^31 seed left far (cross-map) segments never
    # beating it — best_idx stuck at 0, returning the wrong segment. FX_MAX
    # is also 2147483647, so it can't serve as the sentinel here.
    var best_dist = 9223372036854775807;

    for (var i = 0; i < seg_count; i += 1) {
        var base = segs + i * 32;
        var x1 = load64(base);
        var y1 = load64(base + 8);
        var x2 = load64(base + 16);
        var y2 = load64(base + 24);

        var dist = bsp_point_seg_dist(px, py, x1, y1, x2, y2);

        if (dist < best_dist) {
            best_dist = dist;
            best_idx = i;
        }
    }

    return best_idx;
}

# ================================================================
# Count entities in AABB
# ================================================================
# Given an array of entity positions (16 bytes each: x, y),
# count how many fall within the given bounding box.
fn bsp_count_in_aabb(box, entities, entity_count) {
    var count = 0;
    for (var i = 0; i < entity_count; i += 1) {
        var ebase = entities + i * 16;
        var ex = load64(ebase);
        var ey = load64(ebase + 8);
        if (aabb_contains_point(box, ex, ey) == 1) {
            count += 1;
        }
    }
    return count;
}

# --- blockmap.cyr ---

# blockmap.cyr -- grid-based spatial index
# No globals. Pure functions. All 16.16 fixed-point.
#
# A blockmap divides 2D space into a regular grid of cells.
# Each cell stores a list of segment indices that overlap it.
# Used for fast collision detection (only test nearby segments).
#
# Blockmap layout (caller-provided buffer):
#   [0]   origin_x   -- grid origin X (fixed-point)
#   [8]   origin_y   -- grid origin Y (fixed-point)
#   [16]  cell_size  -- cell width/height (fixed-point)
#   [24]  cols       -- number of columns
#   [32]  rows       -- number of rows
#   [40]  data       -- start of cell data
#
# Cell data: each cell is a fixed-size block of segment indices.
# Cell at (col, row) starts at: data + (row * cols + col) * cell_stride
# First i64 in cell = count of segments in this cell
# Remaining = segment indices

enum BlockmapConst {
    BM_ORIGIN_X = 0;
    BM_ORIGIN_Y = 8;
    BM_CELL_SIZE = 16;
    BM_COLS = 24;
    BM_ROWS = 32;
    BM_DATA = 40;
    BM_CELL_MAX_SEGS = 16;
    BM_CELL_STRIDE = 136;
}

# Initialize a blockmap with given bounds and cell size.
# buf = caller-provided buffer, which must hold
#       BM_DATA + cols * rows * BM_CELL_STRIDE bytes.
# Returns: buf on success, or 0 if the grid dimensions are unusable.
#
# Through 1.2.3 this returned `buf` unconditionally. With cols or rows <= 0 the
# zeroing loop ran zero times, so the caller got a "successful" blockmap whose
# cell counts were never initialised — every subsequent query read whatever was
# in the buffer. The dimensions are also capped so that `cols * rows` cannot
# overflow i64 and wrap negative, which would skip the zeroing the same way.
fn blockmap_init(buf, origin_x, origin_y, cell_size, cols, rows) {
    if (cols <= 0) { return 0; }
    if (rows <= 0) { return 0; }
    if (cols > 2147483647) { return 0; }
    if (rows > 2147483647) { return 0; }
    store64(buf + BM_ORIGIN_X, origin_x);
    store64(buf + BM_ORIGIN_Y, origin_y);
    store64(buf + BM_CELL_SIZE, cell_size);
    store64(buf + BM_COLS, cols);
    store64(buf + BM_ROWS, rows);

    # Zero all cell counts
    var total_cells = cols * rows;
    for (var i = 0; i < total_cells; i += 1) {
        store64(buf + BM_DATA + i * BM_CELL_STRIDE, 0);
    }
    return buf;
}

# Convert a world X coordinate to a grid column index.
# Returns 0 if cell_size is 0. The result is NOT clamped to the grid — it can
# be negative or >= cols for positions outside the blockmap; callers that index
# with it must clamp (blockmap_add and blockmap_get_cell both range-check).
fn blockmap_cell_x(bm, wx) {
    var ox = load64(bm + BM_ORIGIN_X);
    var cs = load64(bm + BM_CELL_SIZE);
    if (cs == 0) { return 0; }
    return fx_to_int(fx_div(wx - ox, cs));
}

# Convert a world Y coordinate to a grid row index. Same contract as
# blockmap_cell_x: returns 0 if cell_size is 0, and the result is unclamped.
fn blockmap_cell_y(bm, wy) {
    var oy = load64(bm + BM_ORIGIN_Y);
    var cs = load64(bm + BM_CELL_SIZE);
    if (cs == 0) { return 0; }
    return fx_to_int(fx_div(wy - oy, cs));
}

# Add a segment index to the cell at (col, row).
# Returns 1 if stored, 0 if rejected.
#
# Rejection happens for an out-of-range (col, row) OR when the cell already
# holds BM_CELL_MAX_SEGS (16) segments. The second case is SILENT DATA LOSS
# that a dense map hits with entirely valid input: the segment simply is not
# in the index, and a later blockmap_query_point will not report it, so the
# caller's narrowphase never tests it. Check this return value, or check the
# drop count from blockmap_insert_seg.
fn blockmap_add(bm, col, row, seg_idx) {
    var cols = load64(bm + BM_COLS);
    var rows = load64(bm + BM_ROWS);
    if (col < 0) { return 0; }
    if (row < 0) { return 0; }
    if (col >= cols) { return 0; }
    if (row >= rows) { return 0; }

    var cell = bm + BM_DATA + (row * cols + col) * BM_CELL_STRIDE;
    var count = load64(cell);
    if (count >= BM_CELL_MAX_SEGS) { return 0; }

    store64(cell + 8 + count * 8, seg_idx);
    store64(cell, count + 1);
    return 1;
}

# Insert a segment into every cell its bounding box overlaps.
# Segment endpoints: (x1,y1)-(x2,y2) in fixed-point.
#
# Returns the number of cells that REJECTED the insertion — 0 means fully
# indexed. A non-zero result means those cells were already at
# BM_CELL_MAX_SEGS and this segment is missing from them, so queries over
# that area will not return it. Before 1.2.3 this always returned 0 and the
# loss was undetectable; the value was constant, so reading it is new
# information rather than a changed contract.
#
# Note this inserts by bounding box, not by exact rasterisation: a diagonal
# segment is added to cells its bbox covers but the segment itself misses.
fn blockmap_insert_seg(bm, seg_idx, x1, y1, x2, y2) {
    var c1 = blockmap_cell_x(bm, fx_min(x1, x2));
    var c2 = blockmap_cell_x(bm, fx_max(x1, x2));
    var r1 = blockmap_cell_y(bm, fx_min(y1, y2));
    var r2 = blockmap_cell_y(bm, fx_max(y1, y2));

    var cols = load64(bm + BM_COLS);
    var rows = load64(bm + BM_ROWS);
    if (c1 < 0) { c1 = 0; }
    if (r1 < 0) { r1 = 0; }
    if (c2 >= cols) { c2 = cols - 1; }
    if (r2 >= rows) { r2 = rows - 1; }

    var dropped = 0;
    for (var r = r1; r <= r2; r += 1) {
        for (var c = c1; c <= c2; c += 1) {
            if (blockmap_add(bm, c, r, seg_idx) == 0) { dropped += 1; }
        }
    }
    return dropped;
}

# Query: get pointer to cell data at (col, row).
# Returns pointer to cell (first i64 = count, then indices), or 0.
fn blockmap_get_cell(bm, col, row) {
    var cols = load64(bm + BM_COLS);
    var rows = load64(bm + BM_ROWS);
    if (col < 0) { return 0; }
    if (row < 0) { return 0; }
    if (col >= cols) { return 0; }
    if (row >= rows) { return 0; }
    return bm + BM_DATA + (row * cols + col) * BM_CELL_STRIDE;
}

# Query: get count of segments in cell
fn blockmap_cell_count(cell) {
    if (cell == 0) { return 0; }
    return load64(cell);
}

# Query: get segment index `idx` from a cell, or -1 if the request is invalid.
#
# Guarded to match its sibling blockmap_cell_count, which already tolerates the
# 0 that blockmap_get_cell returns for an out-of-range cell. Before 1.2.3 this
# function dereferenced that 0 and took SIGSEGV, so the documented
# get_cell -> cell_seg sequence could crash on any out-of-range coordinate.
# `idx` is range-checked too: an unchecked idx reads into the NEXT cell's data
# and silently returns a segment that is not in this cell.
fn blockmap_cell_seg(cell, idx) {
    if (cell == 0) { return -1; }
    if (idx < 0) { return -1; }
    # Against the cell's LIVE count, not BM_CELL_MAX_SEGS. 1.2.3 checked the
    # constant cap, which stops the read escaping into the next cell but still
    # hands back whatever sits in this cell's unused slots — a stale index from
    # a previous blockmap_init, or uninitialised memory. Only slots below the
    # live count hold a segment this cell actually contains.
    if (idx >= load64(cell)) { return -1; }
    return load64(cell + 8 + idx * 8);
}

# Broadphase: collect candidate segment indices from every grid cell that
# overlaps the query AABB [px-radius, px+radius] x [py-radius, py+radius].
# This does NOT narrow-filter by exact radius distance, and a segment that
# spans multiple queried cells is reported once PER cell (duplicate indices
# are expected). Callers do exact rejection in narrowphase
# (bsp_point_seg_dist / bsp_seg_intersect) and must dedupe if uniqueness
# matters. Results written to out_buf (array of i64 seg indices).
# Returns number of results written.
fn blockmap_query_point(bm, px, py, radius, out_buf, out_max) {
    var c1 = blockmap_cell_x(bm, px - radius);
    var c2 = blockmap_cell_x(bm, px + radius);
    var r1 = blockmap_cell_y(bm, py - radius);
    var r2 = blockmap_cell_y(bm, py + radius);

    var cols = load64(bm + BM_COLS);
    var rows = load64(bm + BM_ROWS);
    if (c1 < 0) { c1 = 0; }
    if (r1 < 0) { r1 = 0; }
    if (c2 >= cols) { c2 = cols - 1; }
    if (r2 >= rows) { r2 = rows - 1; }

    var out_count = 0;
    for (var r = r1; r <= r2; r += 1) {
        for (var c = c1; c <= c2; c += 1) {
            # c,r are provably in-range after the clamps above (and the loops
            # don't run when cols/rows is 0), so blockmap_get_cell would always
            # return this exact pointer — inline it to drop the per-cell call,
            # two redundant cols/rows reloads, four bounds checks, and the
            # never-false cell != 0 guard.
            var cell = bm + BM_DATA + (r * cols + c) * BM_CELL_STRIDE;
            var n = load64(cell);
            for (var i = 0; i < n; i += 1) {
                # `cell` is provably non-zero and `i < n <= BM_CELL_MAX_SEGS`
                # (blockmap_add caps the stored count), so the guards inside
                # blockmap_cell_seg / blockmap_cell_count can never fire here —
                # load directly and skip two calls and five branches per segment.
                if (out_count >= out_max) { return out_count; }
                store64(out_buf + out_count * 8, load64(cell + 8 + i * 8));
                out_count += 1;
            }
        }
    }
    return out_count;
}

# --- frustum.cyr ---

# frustum.cyr -- view frustum culling (2D)
# No globals. Pure functions. All 16.16 fixed-point.
#
# A 2D view frustum is defined by the viewer position, direction,
# and field of view. It forms a wedge/cone shape.
#
# For BSP rendering, we test if a bounding box is within the
# view frustum before traversing into that subtree.
#
# Frustum stored as 2 half-planes (left edge, right edge):
#   [0]   left_nx   -- left edge normal X (fixed)
#   [8]   left_ny   -- left edge normal Y (fixed)
#   [16]  right_nx  -- right edge normal X (fixed)
#   [24]  right_ny  -- right edge normal Y (fixed)
#   [32]  view_x    -- viewer position X (fixed)
#   [40]  view_y    -- viewer position Y (fixed)

enum FrustumField {
    FR_LEFT_NX = 0;
    FR_LEFT_NY = 8;
    FR_RIGHT_NX = 16;
    FR_RIGHT_NY = 24;
    FR_VIEW_X = 32;
    FR_VIEW_Y = 40;
    FR_SIZE = 48;
}

# Build a frustum from viewer position, facing angle, and half-FOV.
# Requires sin/cos functions from the caller's trig table.
# left_angle = view_angle + fov_half
# right_angle = view_angle - fov_half
fn frustum_build(fr, vx, vy, left_cos, left_sin, right_cos, right_sin) {
    # Left plane normal points inward (perpendicular to left edge, clockwise)
    store64(fr + FR_LEFT_NX, left_sin);
    store64(fr + FR_LEFT_NY, -left_cos);

    # Right plane normal points inward
    store64(fr + FR_RIGHT_NX, -right_sin);
    store64(fr + FR_RIGHT_NY, right_cos);

    store64(fr + FR_VIEW_X, vx);
    store64(fr + FR_VIEW_Y, vy);
    return 0;
}

# Test if point (px, py) is inside the frustum.
# Returns 1 if inside, 0 if outside.
# All operands are signed (dx/dy are diffs, normals can be negative);
# shifts use asr() to preserve sign (Cyrius `>>` is logical).
fn frustum_test_point(fr, px, py) {
    var vx = load64(fr + FR_VIEW_X);
    var vy = load64(fr + FR_VIEW_Y);
    var dx = asr(px - vx, 4);
    var dy = asr(py - vy, 4);

    # Test against left plane
    var left_dot = fx_mul(dx, asr(load64(fr + FR_LEFT_NX), 4))
    + fx_mul(dy, asr(load64(fr + FR_LEFT_NY), 4));
    if (left_dot < 0) { return 0; }

    # Test against right plane
    var right_dot = fx_mul(dx, asr(load64(fr + FR_RIGHT_NX), 4))
    + fx_mul(dy, asr(load64(fr + FR_RIGHT_NY), 4));
    if (right_dot < 0) { return 0; }

    return 1;
}

# Test if AABB is potentially visible in the frustum.
# Conservative: returns 1 if any part might be visible.
# Uses corner testing -- if all 4 corners are outside the
# same half-plane, the box is fully outside.
fn frustum_test_aabb(fr, box) {
    var vx = load64(fr + FR_VIEW_X);
    var vy = load64(fr + FR_VIEW_Y);

    # Pre-scale corner offsets once (signed — use asr).
    var lx = asr(load64(box + AABB_LEFT) - vx, 4);
    var rx = asr(load64(box + AABB_RIGHT) - vx, 4);
    var ty = asr(load64(box + AABB_TOP) - vy, 4);
    var by = asr(load64(box + AABB_BOTTOM) - vy, 4);

    var lnx = asr(load64(fr + FR_LEFT_NX), 4);
    var lny = asr(load64(fr + FR_LEFT_NY), 4);
    var rnx = asr(load64(fr + FR_RIGHT_NX), 4);
    var rny = asr(load64(fr + FR_RIGHT_NY), 4);

    # Test left plane: if all 4 corners have negative dot product, reject.
    # Each plane has only 4 distinct corner products (lx/rx x-normal, ty/by
    # y-normal) shared across the 4 corners -- hoist them (8 fx_mul -> 4).
    var lx_lnx = fx_mul(lx, lnx);
    var rx_lnx = fx_mul(rx, lnx);
    var ty_lny = fx_mul(ty, lny);
    var by_lny = fx_mul(by, lny);
    var l_fail = 0;
    if (lx_lnx + ty_lny < 0) { l_fail += 1; }
    if (rx_lnx + ty_lny < 0) { l_fail += 1; }
    if (lx_lnx + by_lny < 0) { l_fail += 1; }
    if (rx_lnx + by_lny < 0) { l_fail += 1; }
    if (l_fail == 4) { return 0; }

    # Test right plane (same 4-distinct-products structure).
    var lx_rnx = fx_mul(lx, rnx);
    var rx_rnx = fx_mul(rx, rnx);
    var ty_rny = fx_mul(ty, rny);
    var by_rny = fx_mul(by, rny);
    var r_fail = 0;
    if (lx_rnx + ty_rny < 0) { r_fail += 1; }
    if (rx_rnx + ty_rny < 0) { r_fail += 1; }
    if (lx_rnx + by_rny < 0) { r_fail += 1; }
    if (rx_rnx + by_rny < 0) { r_fail += 1; }
    if (r_fail == 4) { return 0; }

    return 1;
}
